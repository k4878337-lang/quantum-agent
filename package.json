{
  "name": "quantum-agent",
  "version": "1.0.0",
  "description": "Quantum-inspired multi-provider AI agent with adaptive possibility engine, quota-aware failover, and MCP support",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "qa": "./dist/cli/terminal.js"
  },
  "mcpName": "io.github.k4878337-lang/quantum-agent",
  "scripts": {
    "build": "tsc && (chmod +x dist/cli/terminal.js dist/index.js 2>/dev/null || true)",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "qa": "tsx src/cli/terminal.ts",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "ai",
    "quantum",
    "multi-provider",
    "openai",
    "claude",
    "gemini",
    "ollama",
    "agent",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/generative-ai": "^0.21.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
