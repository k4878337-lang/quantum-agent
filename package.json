{
  "name": "quantum-agent",
  "version": "1.2.0",
  "description": "Multi-provider AI agent with quota-aware failover, isolated resume, and MCP support",
  "type": "module",
  "main": "./dist/index.js",
  "bin": { "qa": "./dist/cli/terminal.js" },
  "mcpName": "io.github.YOUR_USERNAME/quantum-agent",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "qa": "tsx src/cli/terminal.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["mcp", "ai", "multi-provider", "openai", "claude", "gemini", "deepseek", "ollama", "agent"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
